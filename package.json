{
  "name": "eyeviz-monorepo",
  "private": true,
  "description": "EyeViz — open-source interactive STEM visualization engine by ALumiEye.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @alumieye/eyeviz-playground dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:playground": "pnpm --filter @alumieye/eyeviz-playground build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:packages": "pnpm -r --filter \"./packages/*\" check:package",
    "check:size": "node scripts/check-size.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm build && pnpm check:packages && pnpm check:size && pnpm check:licenses && pnpm build:playground",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
