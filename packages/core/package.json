{
  "name": "@alumieye/eyeviz-core",
  "version": "0.0.0",
  "description": "EyeViz deterministic runtime: Scene Spec → Scene Model → Scene State. No DOM, no renderer.",
  "keywords": [
    "eyeviz",
    "stem",
    "visualization",
    "runtime",
    "deterministic"
  ],
  "license": "Apache-2.0",
  "author": "ALumiEye",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "check:package": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@alumieye/eyeviz-spec": "workspace:*",
    "@alumieye/eyeviz-math": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
